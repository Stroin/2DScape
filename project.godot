; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2DScape"
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[autoload]

SaveGam="*res://Scripts/SaveGame.gd"
Inv="*res://Autoloads/inventory.tscn"
Stats="*res://Autoloads/player_stats.tscn"
ItemManage="*res://Scripts/ItemManager.gd"
RecipeManage="*res://Scripts/RecipeManager.gd"
DurabilityManage="*res://Scripts/DurabilityManager.gd"
ResourceManage="*res://Scripts/ResourceManager.gd"
PauseMenu="*res://Scenes/PauseMenu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[rendering]

textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=true
